# =============================================================================
# Mission Control — environment template
# =============================================================================
# Copy this file OUTSIDE the repository and fill in real values:
#
#   install -d -m 700 "$HOME/.hermes"
#   install -m 600 deploy/systemd/env.template "$HOME/.hermes/mission-control.env"
#
# The systemd units and launcher scripts read ~/.hermes/mission-control.env
# (launchers: or $MISSION_CONTROL_ENV_FILE). The file must be owned by the
# deploying user and have permissions 600.
# NEVER commit real secrets to the repository — this template and the
# documentation in deploy/systemd/SECRETS.md are the only env artifacts
# that belong in git.
#
# Format notes:
#   - One KEY=VALUE pair per line, no `export` prefix (systemd
#     EnvironmentFile-compatible AND bash-sourceable).
#   - Values with spaces or special characters must be single-quoted.
#   - A trailing # starts an inline comment; keep values clean.
#
# Full reference, including how to generate or obtain each secret:
#   deploy/systemd/SECRETS.md
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (required)
# -----------------------------------------------------------------------------

# Bearer token protecting every /api/local/* telemetry endpoint and the
# browser terminal. scripts/run-dashboard-api.sh also passes it to the Hermes
# dashboard API as HERMES_DASHBOARD_SESSION_TOKEN. Required — without it all
# telemetry calls return 401.
# Generate:  openssl rand -base64 32
MISSION_CONTROL_TOKEN=change_me_openssl_rand_base64_32

# Optional legacy name: the telemetry server and the terminal accept
# API_SERVER_KEY only when MISSION_CONTROL_TOKEN is unset. The Hermes
# dashboard API does not read it.
# API_SERVER_KEY=

# Optional: token for the Hermes dashboard API. Defaults to
# MISSION_CONTROL_TOKEN; only set it if your dashboard must use another value
# (Mission Control's REST calls to the dashboard then fail with 401).
# HERMES_DASHBOARD_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Frontend / Vite (build + dev server)
# -----------------------------------------------------------------------------

# Optional. Token the frontend bootstraps into localStorage on first visit.
# Must match MISSION_CONTROL_TOKEN. Vite bakes it into the client bundle, so
# anyone who can load the page can read it: leave it empty when the UI is
# reachable from other machines and enter the token on the lock screen.
VITE_MISSION_CONTROL_TOKEN=

# API base path for the frontend. KEEP THIS RELATIVE (/api/local). Absolute
# URLs break Tailscale access with opaque CORS failures.
VITE_MISSION_CONTROL_LOCAL_API_BASE_URL=/api/local

# Dashboard API host/port. The launcher and Vite proxy consume the same values.
# Empty values fall back to 127.0.0.1:9119 for backward compatibility.
MISSION_CONTROL_DASHBOARD_HOST=127.0.0.1
MISSION_CONTROL_DASHBOARD_PORT=9119

# Optional explicit URL override. If set, this takes precedence over the
# dashboard host/port values above in the Vite proxy.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# -----------------------------------------------------------------------------
# Telemetry server (sidecar, default port 8765)
# -----------------------------------------------------------------------------

# Bind address/port for the telemetry sidecar. 0.0.0.0 is required for
# Tailscale access; 127.0.0.1 is fine for local-only deployments.
MISSION_CONTROL_LOCAL_TELEMETRY_HOST=0.0.0.0
MISSION_CONTROL_LOCAL_TELEMETRY_PORT=8765

# Comma-separated list of Host headers the Vite dev server accepts. Add your
# Tailscale peer IPs / LAN IPs here (e.g. 100.x.y.z,192.168.x.y).
# Without this, remote browsers get "due to access control checks".
MISSION_CONTROL_DEV_HOSTS=

# Optional: strict allowed hosts for the Vite dev server (default
# localhost,127.0.0.1).
# MISSION_CONTROL_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: telemetry server URL used by the Vite dev proxy. Defaults to
# http://127.0.0.1:8765 — override only for remote/containerized setups.
# MISSION_CONTROL_LOCAL_TELEMETRY_URL=http://127.0.0.1:8765


# Optional: comma-separated CORS origin allowlist for the telemetry server.
# When empty, the server mirrors the request Origin (dev-friendly default).
# MISSION_CONTROL_ALLOWED_ORIGIN=http://localhost:5174

# Optional: set to "1"/"true"/"yes" to reject mutating requests (config
# writes, gateway restarts) on the telemetry server.
# MISSION_CONTROL_READ_ONLY=0

# -----------------------------------------------------------------------------
# Web Push notifications (optional — degrades gracefully when unset)
# -----------------------------------------------------------------------------

# VAPID keypair used for Web Push. Generate with pywebpush:
#   python3 -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); \
#   print('public :', v.public_key.decode()); \
#   print('private:', v.private_key.decode())"
# Both keys MUST be set for push to be enabled; otherwise the push server
# reports "disabled" and the UI hides the notifications feature.
MISSION_CONTROL_VAPID_PUBLIC_KEY=
MISSION_CONTROL_VAPID_PRIVATE_KEY=

# Email or URL identifying you as the push sender (required by push services).
MISSION_CONTROL_VAPID_CONTACT=mailto:you@example.com

# Optional: gateway WebSocket URL + root URL used by the push server to proxy
# approval/clarify/secret requests back to the dashboard. Defaults point at
# the Vite dev server (5174) which proxies /api/ws to the dashboard API.
# MISSION_CONTROL_GATEWAY_WS_URL=ws://127.0.0.1:5174/api/ws
# MISSION_CONTROL_GATEWAY_ROOT_URL=http://127.0.0.1:5174/api/gateway-root

# Optional: seconds to wait before reconnecting the push server's gateway
# WebSocket after a drop.
# MISSION_CONTROL_WS_RECONNECT_DELAY=5

