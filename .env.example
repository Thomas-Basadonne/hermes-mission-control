# Mission Control environment template.
#
# Who reads what:
#   - Vite (pnpm dev) reads ./.env in the repository root.
#   - The launcher scripts (pnpm dev:telemetry, scripts/run-dashboard-api.sh,
#     the systemd units) read $MISSION_CONTROL_ENV_FILE, or
#     ~/.hermes/mission-control.env when that variable is unset. They do NOT
#     read ./.env on their own.
# To use this single file for everything, export
#   MISSION_CONTROL_ENV_FILE="$PWD/.env"
# before running pnpm dev:full and scripts/run-dashboard-api.sh.
# See README.md -> Configuration.

# Access token (required). One value authenticates the telemetry sidecar,
# the browser, and (through scripts/run-dashboard-api.sh, which exports it as
# HERMES_DASHBOARD_SESSION_TOKEN) the Hermes dashboard API.
# Generate: openssl rand -base64 32
MISSION_CONTROL_TOKEN=your_token_here

# Browser copy of the same token (optional). Vite bakes VITE_* variables into
# the client bundle, so anyone who can load the page can read it. Set it only
# for loopback-only use; otherwise leave it empty and paste the token into the
# lock screen (it is kept in the browser's localStorage).
VITE_MISSION_CONTROL_TOKEN=your_token_here

# Frontend API base path (keep relative for proxy compatibility).
VITE_MISSION_CONTROL_LOCAL_API_BASE_URL=/api/local

# Hermes dashboard API endpoint, shared by scripts/run-dashboard-api.sh and the
# Vite proxy. Empty values use the defaults 127.0.0.1:9119.
MISSION_CONTROL_DASHBOARD_HOST=127.0.0.1
MISSION_CONTROL_DASHBOARD_PORT=9119
# Optional explicit Vite proxy target; takes precedence over host/port.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# Optional Vite proxy target for the telemetry sidecar.
# MISSION_CONTROL_LOCAL_TELEMETRY_URL=http://127.0.0.1:8765

# Telemetry sidecar bind address. Legacy aliases TELEMETRY_BIND_HOST /
# TELEMETRY_BIND_PORT are still honored; these names win when both are set.
# SECURITY: the default is loopback. Use 0.0.0.0 ONLY for deliberate
# LAN/Tailscale exposure.
MISSION_CONTROL_LOCAL_TELEMETRY_HOST=127.0.0.1
MISSION_CONTROL_LOCAL_TELEMETRY_PORT=8765

# Remote access through the Vite dev server (optional). Comma-separated
# hostnames or IPs added to Vite's allowedHosts, e.g. a Tailscale IP and a LAN
# IP: 100.x.y.z,192.168.x.y
MISSION_CONTROL_DEV_HOSTS=
# Base allow-list (default: localhost,127.0.0.1).
# MISSION_CONTROL_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allow-list (optional). When set, the sidecar answers cross-origin
# requests ONLY for this exact origin. Unset mirrors the incoming Origin.
#   MISSION_CONTROL_ALLOWED_ORIGIN=http://<host>:5174
# MISSION_CONTROL_ALLOWED_ORIGIN=

# Read-only mode (optional): reject every mutating HTTP method on the sidecar.
# MISSION_CONTROL_READ_ONLY=1

# Provider-usage visibility (optional local allowlist; unset shows all).
# MISSION_CONTROL_USAGE_PROVIDERS=codex,ollama,openrouter,nous
# Optional local field presentation overrides:
# MISSION_CONTROL_USAGE_CONFIG_FILE=~/.hermes/mission-control-usage.json

# Web Push (optional). Requires the optional packages first:
#   python3 -m pip install -r server/requirements-push.txt
# Then generate a VAPID keypair, e.g. via pywebpush:
#   python3 -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..."
# The public key is served to the client for pushManager.subscribe(); the
# private key signs the Web Push Protocol requests. Push is enabled only when
# the two keys AND MISSION_CONTROL_VAPID_CONTACT below are all set; otherwise
# it degrades to "disabled" with a precise reason on /health.
MISSION_CONTROL_VAPID_PUBLIC_KEY=
MISSION_CONTROL_VAPID_PRIVATE_KEY=
# Email or URL identifying you as the push sender (required by push services).
MISSION_CONTROL_VAPID_CONTACT=
